# Copy this file's values into your host's environment variable settings.
# (Spring Boot reads these directly -- you don't need a .env loader.)

# Activates application-prod.yml (PostgreSQL) instead of the default H2 profile
SPRING_PROFILES_ACTIVE=prod

# From your Neon (or any Postgres) connection details
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Your deployed frontend URL(s), comma-separated, no trailing slash
FRONTEND_ORIGINS=https://your-portfolio.vercel.app,http://localhost:5173

# Optional: lets you view submitted contact messages at GET /api/contact
# with header "X-Admin-Key: <this value>". Leave unset to disable.
ADMIN_API_KEY=choose-a-long-random-string
